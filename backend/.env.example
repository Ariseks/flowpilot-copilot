# 留空即启用 deterministic demo 模式
LLM_API_KEY=
# 当前代码使用 OpenAI Chat Completions 兼容协议
# sk- 普通 API Key 使用普通 API 地址
LLM_BASE_URL=https://api.xiaomimimo.com/v1
LLM_MODEL=mimo-v2.5-pro
# tp- Token Plan Key 才使用以下地址：
# https://token-plan-cn.xiaomimimo.com/v1
# Anthropic 兼容地址暂未接入当前适配器：
# https://token-plan-cn.xiaomimimo.com/anthropic
# 可选：JSON 状态文件路径
DATA_FILE=data/state.json
# 单进程内存固定窗口限流。设为 0 可关闭；多实例部署应改用 Redis 等共享存储。
RATE_LIMIT=120
RATE_WINDOW_SECONDS=60
